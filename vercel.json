{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(css|js|assets)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(.*\\.(html|ico|png|jpg|jpeg|svg|gif|woff|woff2|ttf|map))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}